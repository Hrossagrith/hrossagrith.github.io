{
  "version": 1,
  "notes": {
    "en": "Structural catalogue for the bit-mechanics register. Every number under `model` is a modelling parameter with its justification in text.json (section `model_params`). Lengths in millimetres, forces in newtons.",
    "ru": "Структурный каталог реестра механики удил. Каждое число в `model` — параметр модели; обоснование в text.json (раздел `model_params`). Длины в миллиметрах, силы в ньютонах."
  },

  "groups": [
    {
      "id": "snaffle",
      "name": { "en": "Snaffle — direct action", "ru": "Трензели — прямое действие" },
      "summary": {
        "en": "The rein attaches at the level of the mouthpiece. No lever, no multiplication: the mouth receives the rein force, redistributed by the cheek and the mouthpiece.",
        "ru": "Повод крепится на уровне грызла. Нет рычага и нет умножения: рот получает силу повода, перераспределённую щёчкой и грызлом."
      }
    },
    {
      "id": "leverage",
      "name": { "en": "Leverage — curb and gag", "ru": "Рычажные — мундштучные и гаги" },
      "summary": {
        "en": "The rein acts below or through the mouthpiece. A curb multiplies the rein force against a chin chain; a gag redirects it upward along the cheekpiece.",
        "ru": "Повод действует ниже грызла или через него. Мундштук умножает силу повода, опираясь на подбородную цепочку; гаг перенаправляет её вверх вдоль нащёчного ремня."
      }
    }
  ],

  "subgroups": [
    { "id": "ring", "group": "snaffle", "name": { "en": "Ring cheeks", "ru": "Кольцевые щёчки" } },
    { "id": "fixed", "group": "snaffle", "name": { "en": "Fixed and guided cheeks", "ru": "Фиксированные и направляющие щёчки" } },
    { "id": "curb", "group": "leverage", "name": { "en": "Curb (chin chain)", "ru": "Мундштучные (с подбородной цепочкой)" } },
    { "id": "gag", "group": "leverage", "name": { "en": "Gag (no chain)", "ru": "Гаги (без цепочки)" } }
  ],

